# ─── Web / Vercel deployment only ────────────────────────────────────────────
# GitHub OAuth app credentials — required for the web app's GitHub OAuth flow.
# Create an OAuth app at: https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/auth/github/callback
# Not needed for local dev (Electron uses gh CLI auth instead).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub repo containing skill definitions, in owner/repo format.
# e.g. SKILLS_REPO=besley1600/vigil
# Skills (SKILL.md files) are always read from this repo for all users.
# If unset, skill definitions fall back to each user's selected repo.
SKILLS_REPO=

# ─── Optional overrides ───────────────────────────────────────────────────────

# Absolute path to the Vigil repo root — only needed if running the Next.js
# server from a non-standard working directory (e.g. custom Docker setups).
# Defaults to one level above the dashboard/ directory.
# REPO_ROOT=
