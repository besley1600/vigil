# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=

# Your Vigil repository in owner/repo format
GITHUB_REPO=

# ─── Optional overrides ───────────────────────────────────────────────────────

# Absolute path to the Vigil repo root — only needed if running the Next.js
# server from a non-standard working directory (e.g. custom Docker setups).
# Defaults to one level above the dashboard/ directory.
# REPO_ROOT=
