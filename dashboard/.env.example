# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=

# Your Vigil repository in owner/repo format
GITHUB_REPO=

# ─── Web3 / VIGIL Token (set after contract deployment) ───────────────────────

# WalletConnect project ID (optional — enables mobile wallets, create at cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoints (use Alchemy/Infura/QuickNode for reliability)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Mainnet contract addresses (fill in after deploying to Base)
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=

# Testnet contract addresses (fill in after deploying to Base Sepolia)
NEXT_PUBLIC_TOKEN_ADDRESS_TESTNET=
NEXT_PUBLIC_STAKING_ADDRESS_TESTNET=
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS_TESTNET=
